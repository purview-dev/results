<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<!--
			net11.0 only: this project declares unions generated by Purview.Unions, and the results helpers they
			opt into. Compiler unions need System.Runtime.CompilerServices.IUnion and UnionAttribute, which do
			not exist before .NET 11, so the declaration cannot compile for net10.0. The shipped packages
			multi-target both; Purview.Unions emits internal polyfills on net10.0.
		-->
		<TargetFrameworks></TargetFrameworks>
		<TargetFramework>net11.0</TargetFramework>
	</PropertyGroup>
	<PropertyGroup>
		<!--
			A runnable console example, so it is started with `dotnet run` rather than referenced. It stays
			non-packable (the SDK default) because it is documentation, not a shipped package.
		-->
		<OutputType>Exe</OutputType>
	</PropertyGroup>

	<ItemGroup>
		<!-- The runtime type the generated AsFailure helpers build on. -->
		<ProjectReference Include="..\Results\Results.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!--
			Purview.Unions generates the union's [Union] attribute, storage, constructors and TryGetValue
			members from the source-visible case list. Its generator ships inside the package, so one
			PackageReference is enough.
		-->
		<PackageReference Include="Purview.Unions" />
	</ItemGroup>

	<ItemGroup>
		<!--
			The results generator is a Roslyn component: it is referenced analyzer-style so it produces the
			AsFailure<TValue>() helpers for this project's TenantError union without becoming a runtime
			dependency, and without flowing to anything that references this project. Both generators run in
			this compilation, which is the integration this example demonstrates.
		-->
		<ProjectReference
			Include="..\SourceGenerator\SourceGenerator.csproj"
			OutputItemType="Analyzer"
			ReferenceOutputAssembly="false"
			PrivateAssets="all"
		/>
	</ItemGroup>
</Project>
