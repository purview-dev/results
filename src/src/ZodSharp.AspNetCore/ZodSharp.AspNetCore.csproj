<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<IsPackable>true</IsPackable>
		<Title>Purview Results ZodSharp ASP.NET Core</Title>
		<Description>Maps Purview result failures that carry ZodSharp validation errors onto ASP.NET Core HttpValidationProblemDetails responses.</Description>
		<PackageTags>results;result;aspnetcore;problemdetails;validation;zod;purview;</PackageTags>
	</PropertyGroup>

	<!--
		Trimming and Native AOT. Verified clean under both analyzers. See AspNetCore.csproj.
	-->
	<PropertyGroup Label="Trimming and Native AOT">
		<IsAotCompatible>true</IsAotCompatible>
	</PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Purview.ZodSharp.AspNetCore" />
	</ItemGroup>

	<ItemGroup>
		<!--
			ZodSharp types (ZodException, ValidationError) are used directly by the mapping, so the package is
			referenced explicitly rather than relied on transitively through Purview.ZodSharp.AspNetCore.
		-->
		<PackageReference Include="Purview.ZodSharp" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\AspNetCore\AspNetCore.csproj" />
		<ProjectReference Include="..\ZodSharp\ZodSharp.csproj" />
	</ItemGroup>
</Project>
