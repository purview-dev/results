<Project Sdk="Microsoft.NET.Sdk">
	<!--
		Integration package that bridges ZodSharp validation results into Purview.Results.
		It stays a leaf library: Results never depends on ZodSharp, and consumers opt in by referencing
		this package.
	-->
	<!--
		Trimming and Native AOT. Verified clean under both the trim and AOT analyzers. See Results.csproj.
	-->
	<PropertyGroup Label="Trimming and Native AOT">
		<IsAotCompatible>true</IsAotCompatible>
	</PropertyGroup>

	<!--
		PurviewBrowserSafe: the bridge is downloaded to a browser by the Blazor WebAssembly example and by
		real WebAssembly consumers, so the SDK runs the trim, AOT and browser-unsupported-API checks here.
	-->
	<PropertyGroup Label="Browser safety">
		<PurviewBrowserSafe>true</PurviewBrowserSafe>
	</PropertyGroup>

	<PropertyGroup>
		<IsPackable>true</IsPackable>
		<Title>Purview Results ZodSharp</Title>
		<Description>Bridges ZodSharp ValidationResult&lt;T&gt; values into Purview.Results, so validation outcomes flow through the result pipeline as ordinary error values instead of exceptions.</Description>
		<PackageTags>results;result;validation;zod;zodsharp;purview;</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Purview.ZodSharp" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Results\Results.csproj" />
	</ItemGroup>
</Project>
