<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup Label="Agent Skills">
		<!-- Authored at the repository root in skills/; packed into .agents/skills/ so consumers
		     still receive them through the mirror. See src/Directory.Build.targets. -->
		<PurviewSkillsToPack>purview-results-http-mapping</PurviewSkillsToPack>
	</PropertyGroup>

	<PropertyGroup>
		<IsPackable>true</IsPackable>
		<Title>Purview Results ASP.NET Core</Title>
		<Description>Maps Purview.Results results onto ASP.NET Core responses, including ProblemDetails for expected failures.</Description>
		<PackageTags>results;result;aspnetcore;problemdetails;minimal-api;purview;</PackageTags>
	</PropertyGroup>

	<!--
		Trimming and Native AOT. Verified clean under both analyzers. The successful value reaches
		TypedResults through IResultValue.AcceptSuccess, so it binds Ok<TValue> with the endpoint's real value
		type rather than Ok<object> — which also restores the response type ASP.NET Core infers for OpenAPI.
	-->
	<PropertyGroup Label="Trimming and Native AOT">
		<IsAotCompatible>true</IsAotCompatible>
	</PropertyGroup>

	<!--
		This package deliberately knows nothing about ZodSharp: it maps results onto responses using the mappings a
		host registers for its own error types. Consumers that want validation failures rendered as
		HttpValidationProblemDetails also reference Purview.Results.ZodSharp.AspNetCore.
	-->
	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Results\Results.csproj" />
	</ItemGroup>
</Project>
