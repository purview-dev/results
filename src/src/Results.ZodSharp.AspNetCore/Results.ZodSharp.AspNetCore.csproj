<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<Title>Purview Results ZodSharp ASP.NET Core</Title>
		<Description>Maps Purview result failures that carry ZodSharp validation errors onto ASP.NET Core HttpValidationProblemDetails responses.</Description>
		<PackageTags>results;result;aspnetcore;problemdetails;validation;zod;purview;</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Purview.ZodSharp.AspNetCore" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Results.AspNetCore\Results.AspNetCore.csproj" />
		<ProjectReference Include="..\Results.ZodSharp\Results.ZodSharp.csproj" />
	</ItemGroup>
</Project>
