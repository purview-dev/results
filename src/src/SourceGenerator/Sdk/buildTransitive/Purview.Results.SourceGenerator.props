<Project>
	<!--
		Shipped inside the Purview.Results.SourceGenerator package as buildTransitive/** (project
		Sdk/buildTransitive/Purview.Results.SourceGenerator.props maps to the package root), so PackageReference
		consumers receive the compiler-visible property the generator reads. Without it,
		$(ResultsSourceGenerator_Disable) would never reach the generator and the documented switch would
		silently do nothing outside this repository.

		The framework's PSGF0003 validation checks that every property declared as generator-read
		(PurviewGeneratorVisibleProperty) is either a CompilerVisibleProperty in the build or declared by this
		package's own Sdk/build* assets, which keeps this file and the generator in sync.
	-->
	<ItemGroup Label="Compiler Visible Generator Properties">
		<CompilerVisibleProperty Include="ResultsSourceGenerator_Disable">
			<Description>True to disable the generated result helpers while still emitting the opt-in [GenerateResult] attribute.</Description>
		</CompilerVisibleProperty>
	</ItemGroup>
</Project>
