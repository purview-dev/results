<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<!--
			A runnable console example, started with `dotnet run` rather than referenced. It stays non-packable
			(the SDK default) because it is documentation, not a shipped package.
		-->
		<OutputType>Exe</OutputType>
	</PropertyGroup>

	<ItemGroup>
		<!-- The runtime type the generated AsFailure helpers build on. -->
		<ProjectReference Include="..\Results\Results.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- The bridge that turns a ValidationResult<T> into a result. -->
		<ProjectReference Include="..\ZodSharp\ZodSharp.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!--
			ZodSharp itself: [ZodSchema], [ZodRule], the rule interfaces (IValidationRule<T>/IZodRule),
			ValidationResult<T> and ValidationError.
		-->
		<PackageReference Include="Purview.ZodSharp" />
	</ItemGroup>

	<ItemGroup>
		<!--
			The scalar value object: [Scalar], IScalarValueObject<TSelf, TValue>, and the generator that emits
			Create/Hydrate plus the [ZodSchema] integration, so a type-level rule validates the value object as a
			unit. This example is the only one that takes this dependency, because composition with value objects
			is the aspect it demonstrates.
		-->
		<PackageReference Include="Purview.ValueObjects" />
	</ItemGroup>

	<ItemGroup>
		<!--
			The generator is a Roslyn component: it is referenced analyzer-style so it produces the
			AsFailure<TValue>() helpers for this project's TenantError union without becoming a runtime
			dependency, and without flowing to anything that references this project.
		-->
		<ProjectReference
			Include="..\SourceGenerator\SourceGenerator.csproj"
			OutputItemType="Analyzer"
			ReferenceOutputAssembly="false"
			PrivateAssets="all"
		/>
	</ItemGroup>
</Project>
