<Solution>
	<Folder Name="/Solution Items/">
		<File Path="../.editorconfig" />
		<File Path="../Directory.Packages.props" />
		<File Path="../global.json" />
		<File Path="../Justfile" />
		<File Path="../nuget.config" />
		<File Path="../package.json" />
		<File Path="../purview-build.json" />
		<File Path="Directory.Build.props" />
		<File Path="Directory.Build.targets" />
	</Folder>
	<Folder Name="/src/">
		<Project Path="src/Results/Results.csproj" />
		<Project Path="src/AspNetCore/AspNetCore.csproj" />
		<Project Path="src/SourceGenerator/SourceGenerator.csproj" />
		<Project Path="src/SourceGenerator.CodeFixes/SourceGenerator.CodeFixes.csproj" />
		<Project Path="src/ZodSharp/ZodSharp.csproj" />
		<Project Path="src/ZodSharp.AspNetCore/ZodSharp.AspNetCore.csproj" />
	</Folder>
	<Folder Name="/examples/">
		<!--
			Runnable, non-packable examples: one per integration aspect, all built on the Tenancy domain the
			README documents. They are not test projects, so purview-build.json's TestRoot does not pick them up.
		-->
		<Project Path="examples/Examples.Basic/Examples.Basic.csproj" />
		<Project Path="examples/Examples.Zod/Examples.Zod.csproj" />
		<Project Path="examples/Examples.AspNetCore/Examples.AspNetCore.csproj" />
		<Project Path="examples/Examples.AspNetCore.Zod/Examples.AspNetCore.Zod.csproj" />
	</Folder>
	<Folder Name="/tests/">
		<Project Path="tests/AspNetCore.UnitTests/AspNetCore.UnitTests.csproj" />
		<Project Path="tests/SourceGenerator.UnitTests/SourceGenerator.UnitTests.csproj" />
		<Project Path="tests/Results.UnitTests/Results.UnitTests.csproj" />
		<Project Path="tests/ZodSharp.AspNetCore.UnitTests/ZodSharp.AspNetCore.UnitTests.csproj" />
		<Project Path="tests/ZodSharp.UnitTests/ZodSharp.UnitTests.csproj" />
	</Folder>
</Solution>
