<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<!--
			net11.0 only: this project declares a union. Unions need the compiler's
			System.Runtime.CompilerServices.IUnion and UnionAttribute, which do not exist before .NET 11, so
			the declaration cannot compile for net10.0. The shipped packages multi-target both.
		-->
		<TargetFrameworks></TargetFrameworks>
		<TargetFramework>net11.0</TargetFramework>
	</PropertyGroup>
	<ItemGroup>
		<!-- The mapping produces ASP.NET Core responses. -->
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<!-- The problem options and exception handler the mapping shares its behaviour with. -->
		<PackageReference Include="Purview.ZodSharp.AspNetCore" />
	</ItemGroup>

	<ItemGroup>
		<!--
			The value-object generator and ZodSharp types, so the end-to-end test can declare a real
			[Scalar] + [ZodSchema] + [ZodRule] value object whose type-level rule owns its code and origin.
			ZodSharp types are used directly, so the package is referenced explicitly rather than relied on
			transitively through Purview.ZodSharp.AspNetCore.
		-->
		<PackageReference Include="Purview.ValueObjects" />
		<PackageReference Include="Purview.ZodSharp" />
	</ItemGroup>

	<ItemGroup>
		<!-- Produces the AsFailure helpers for this project's own test union. -->
		<ProjectReference
			Include="..\..\src\SourceGenerator\SourceGenerator.csproj"
			OutputItemType="Analyzer"
			ReferenceOutputAssembly="false"
			PrivateAssets="all"
		/>
	</ItemGroup>
</Project>
