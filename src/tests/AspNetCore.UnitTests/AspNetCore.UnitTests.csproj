<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<!--
			net11.0 only: this project declares a union. Unions need the compiler's
			System.Runtime.CompilerServices.IUnion and UnionAttribute, which do not exist before .NET 11, so
			the declaration cannot compile for net10.0. The shipped packages multi-target both.
		-->
		<TargetFrameworks></TargetFrameworks>
		<TargetFramework>net11.0</TargetFramework>
	</PropertyGroup>
	<ItemGroup>
		<!-- The endpoint filter tests run an in-process ASP.NET Core application. -->
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<!-- Lets the in-process host be driven with an HttpClient instead of a socket. -->
		<PackageReference Include="Microsoft.AspNetCore.TestHost" />
	</ItemGroup>

	<ItemGroup>
		<!-- Produces the AsFailure helpers for this project's own test union. -->
		<ProjectReference
			Include="..\..\src\SourceGenerator\SourceGenerator.csproj"
			OutputItemType="Analyzer"
			ReferenceOutputAssembly="false"
			PrivateAssets="all"
		/>
	</ItemGroup>
</Project>
