<Project Sdk="Microsoft.NET.Sdk">
	<ItemGroup>
		<!-- The endpoint filter tests run an in-process ASP.NET Core application. -->
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<!-- Lets the in-process host be driven with an HttpClient instead of a socket. -->
		<PackageReference Include="Microsoft.AspNetCore.TestHost" />
	</ItemGroup>

	<ItemGroup>
		<!-- Produces the AsFailure helpers for this project's own test union. -->
		<ProjectReference
			Include="..\..\src\Results.SourceGenerator\Results.SourceGenerator.csproj"
			OutputItemType="Analyzer"
			ReferenceOutputAssembly="false"
			PrivateAssets="all"
		/>
	</ItemGroup>
</Project>
