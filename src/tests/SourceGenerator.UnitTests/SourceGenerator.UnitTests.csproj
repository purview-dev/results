<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<!--
			net11.0 only: this project declares a union. Unions need the compiler's
			System.Runtime.CompilerServices.IUnion and UnionAttribute, which do not exist before .NET 11, so
			the declaration cannot compile for net10.0. The shipped packages multi-target both.
		-->
		<TargetFrameworks></TargetFrameworks>
		<TargetFramework>net11.0</TargetFramework>
		<!--
			RSG1006 is deliberate test data, not a defect: NullableValue declares string? (normalised to
			string), so it owns the shared string case's AsFailure helper and TypedOrText<T> must use its
			union-receiver factory instead. GenericUnionTests exercises TypedOrText<int>.Failure<int, int>(...)
			on that path, which is exactly the shared-case-safe form the rule recommends. The generator reports
			compilation-wide findings like RSG1006, so a #pragma around the declaration does not suppress it;
			the project-level NoWarn is the scoped, documented suppression for this test fixture.
		-->
		<NoWarn>$(NoWarn);RSG1006</NoWarn>
	</PropertyGroup>
	<ItemGroup>
		<!--
			Runs the generator against this project so the generated [GenerateResult] attribute and the
			generated result helpers can be used directly by the runtime and integration tests below.
		-->
		<ProjectReference
			Include="..\..\src\SourceGenerator\SourceGenerator.csproj"
			OutputItemType="Analyzer"
			ReferenceOutputAssembly="false"
			PrivateAssets="all"
		/>
		<!--
			The BuildSdk automatically adds the plain reference to the generator project (the test project's
			target project, resolved by name), which is what makes ResultsSourceGenerator available to
			TUnitSourceGeneratorTestBase<ResultsSourceGenerator>.
		-->
		<!-- The runtime Results library the generated helpers target. -->
		<ProjectReference Include="..\..\src\Results\Results.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!--
			The code fix ships in the generator package as a separate Roslyn component, so the tests reference it
			directly to instantiate the provider. The Workspaces layer is a code-fix dependency the IDE host
			provides; the tests use it for the AdhocWorkspace the harness applies the fix through.
		-->
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\SourceGenerator.CodeFixes\SourceGenerator.CodeFixes.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Purview.SourceGeneratorFramework.Testing.TUnit" />
		<!--
			The real union generator, so both generators run in this project's compilation. The shipped
			results generator never references Purview.Unions: it recognises [GenerateUnion] by metadata
			identity, which this package proves rather than a hand-written stand-in.
		-->
		<PackageReference Include="Purview.Unions" />
	</ItemGroup>
</Project>
