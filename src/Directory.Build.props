<Project>
	<PropertyGroup>
		<NamespacePrefix>Purview.Results</NamespacePrefix>
		<RepositoryUrl>https://github.com/purview-dev/results</RepositoryUrl>

		<!--
			.NET 10 and .NET 11. Consumers choose: .NET 10 is the long-term line, .NET 11 is the current
			standard-term release (GA on 2026-11-10) where C# 15 unions land. Targeting both means adopting
			these packages does not force a runtime upgrade. .NET 8 and .NET 9 are deliberately not targeted —
			both are now out of support.

			That is exactly Purview.BuildSdk's 'Supported' set, so the list is selected rather than spelled
			out here: a runtime lifecycle change becomes an SDK bump instead of an edit in this file.
		-->
		<PurviewTargetFrameworkSet>Supported</PurviewTargetFrameworkSet>

		<!--
			Installed skills live in the universal .agents/skills/ folder only, and are committed. The
			SDK's default (*) would make InstallPurviewSkills write a copy into every agent's folder.
		-->
		<PurviewSkillsAgents>universal</PurviewSkillsAgents>
		<!--
			Compile with the latest *released* C# version, never a preview one. The .NET 11 SDK makes C# 15
			the default for net11.0, which is where union declarations and closed hierarchies live. `preview`
			would enable unshipped language features in shipping packages for no benefit, and the union
			syntax no longer needs it: C# 15 and its runtime types are GA.
		-->
		<LangVersion>latest</LangVersion>

		<!--
			.NET 11 feature selection is the SDK's: MemorySafetyRules defaults to tier 2
			(updated-memory-safety-rules). PurviewMultiThreadedBuild is deliberately false (see above): the
			.NET 11 WebAssembly SDK cannot build a Blazor WebAssembly project under -mt, and the solution
			contains one. Runtime async (PurviewRuntimeAsync) is opted into in Directory.Build.targets, for
			net11.0 examples that are not browser-hosted only, and is forced off for every packable project:
			it needs IsPackable, which a project declares after this file is imported, and the SDK reads the
			switch as it imports in the targets file. See the comment there for why a shipped or WebAssembly
			assembly must not use it.
		-->

		<!--
			EnablePreviewFeatures is deliberately NOT set.

			Setting it emits [assembly: RequiresPreviewFeatures] into every shipped assembly, which makes
			CA2252 (error severity by default) fire on every member a consumer touches. That is
			assembly-wide, so it applied even to Result<TValue, TError>, which uses no union feature — a
			consuming application could not adopt the result type at all without turning preview features
			on solution-wide. Partial adoption was impossible.

			It is also unnecessary: union declarations and closed hierarchies are released C# 15 language
			features; they need the .NET 11 runtime types (IUnion/UnionAttribute and
			IsClosedTypeAttribute), not EnablePreviewFeatures. Every project here, including the
			union-declaring examples and tests, compiles without EnablePreviewFeatures. It gates runtime APIs
			annotated [RequiresPreviewFeatures], and nothing in this repository uses one.

			A consumer that declares its own [GenerateResult] union still needs a net11.0 (or later) target,
			because the union runtime types are theirs to compile against. A consumer that only uses the
			result types needs nothing special. Do not reintroduce this property without re-reading
			docs/wiki/Getting-Started.md, which documents that distinction.
		-->

		<!--
			These packages are deliberately dependency-light: no telemetry generator, no Microsoft.Extensions
			telemetry abstractions. Consumers opt into telemetry in their own host, so the SDK's telemetry defaults
			are excluded repo-wide.
		-->
		<ExcludePurviewTelemetry>true</ExcludePurviewTelemetry>
		<!--
			MSBuild's multithreaded build mode (-mt) cannot build a Blazor WebAssembly project on the .NET 11
			GA SDK: the WebAssembly SDK's JsonToItemsTaskFactory on ReadWasmProps does not support the
			out-of-process task host that -mt uses, and the build fails with MSB4060. The repository ships a
			Blazor WebAssembly sample, so it takes the SDK's supported opt-out rather than excluding the
			sample from the build. The SDK writes -mt:false into Directory.Build.rsp.
		-->
		<PurviewMultiThreadedBuild>false</PurviewMultiThreadedBuild>
	</PropertyGroup>

	<Import Sdk="Purview.BuildSdk" Project="Sdk.props" />

	<ItemGroup>
		<NamespaceRemoveSuffix Remove="SourceGenerator" />
		<NamespaceRemoveSuffix Remove="CodeFixes" />
		<NamespaceRemoveSuffix Remove="Analyzers" />
	</ItemGroup>

	<!--
		Package metadata lives after the SDK import so it can use SDK-provided values such as
		$(CurrentYear). Each packable project opts in with <IsPackable>true</IsPackable> in its own
		project file, because the SDK reads that declaration from the project file text.

		PurviewProjectUrl/PurviewDocsUrl are the site's project and documentation pages for this
		repository, matching the other purview-dev repos; PackageProjectUrl points at the project
		page rather than the repository.
	-->
	<PropertyGroup Label="Purview site URL metadata">
		<PurviewHomepage>https://purview.dev/</PurviewHomepage>
		<PurviewProjectUrl>$(PurviewHomepage)projects/results/</PurviewProjectUrl>
		<PurviewDocsUrl>$(PurviewHomepage)docs/results/</PurviewDocsUrl>
	</PropertyGroup>

	<PropertyGroup Label="NuGet package metadata">
		<Authors>Kieron Lanning</Authors>
		<Company>Purview-Dev</Company>
		<Copyright>Copyright © $(CurrentYear) Purview-Dev</Copyright>
		<PackageProjectUrl>$(PurviewProjectUrl)</PackageProjectUrl>
		<RepositoryType>git</RepositoryType>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<PackageIcon>purview-logo-light.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
	</PropertyGroup>

	<!--
		The package icon is packed at the package root (the SDK's Sdk/ convention), so the same asset
		is reused by every packable project without duplicating it in each project folder.
	-->
	<ItemGroup Label="NuGet package assets" Condition="'$(IsPackable)' == 'true'">
		<None
			Include="$(MSBuildThisFileDirectory)../assets/images/purview-logo-light.png"
			Link="Sdk\purview-logo-light.png"
		/>
	</ItemGroup>
</Project>
