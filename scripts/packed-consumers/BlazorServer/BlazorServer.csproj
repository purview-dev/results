<Project Sdk="Microsoft.NET.Sdk.Web">
	<!--
		Packed-consumer gate (scripts/test-packed-consumers.ps1), consumer (c): a Blazor Web App over every Purview.Results
		package - Purview.Results, .ZodSharp, .AspNetCore and .ZodSharp.AspNetCore - and nothing else from the
		repository. The script copies this folder (and ../Shared) outside the repository, beside guard
		Directory.Build.props/.targets and Directory.Packages.props files, and supplies the versions as
		$(ResultsPackageVersion) and $(ZodSharpPackageVersion).

		It is published and started. A minimal API maps the registration result onto HTTP (a validation problem, a code
		rule's 422, a case mapping's 409, a 200); a statically rendered form is posted; and an interactive-server page
		is prerendered, then run over a live circuit in a headless browser when one is available.
	-->
	<PropertyGroup>
		<TargetFramework>net11.0</TargetFramework>
		<LangVersion>preview</LangVersion>
		<AssemblyName>PackedResultsServer</AssemblyName>
		<RootNamespace>PackedResultsServer</RootNamespace>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<InvariantGlobalization>true</InvariantGlobalization>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Purview.Results" Version="$(ResultsPackageVersion)" />
		<PackageReference Include="Purview.Results.ZodSharp" Version="$(ResultsPackageVersion)" />
		<PackageReference Include="Purview.Results.AspNetCore" Version="$(ResultsPackageVersion)" />
		<PackageReference Include="Purview.Results.ZodSharp.AspNetCore" Version="$(ResultsPackageVersion)" />
		<PackageReference Include="Purview.ZodSharp" Version="$(ZodSharpPackageVersion)" />
		<PackageReference Include="Purview.ZodSharp.AspNetCore" Version="$(ZodSharpPackageVersion)" />
		<PackageReference Include="Purview.ZodSharp.Blazor" Version="$(ZodSharpPackageVersion)" />
	</ItemGroup>

	<Target Name="RequirePackageVersions" BeforeTargets="CollectPackageReferences;Restore">
		<Error
			Condition="'$(ResultsPackageVersion)' == '' or '$(ZodSharpPackageVersion)' == ''"
			Text="ResultsPackageVersion and ZodSharpPackageVersion must be set. Run this consumer through scripts/test-packed-consumers.ps1."
		/>
	</Target>
</Project>
