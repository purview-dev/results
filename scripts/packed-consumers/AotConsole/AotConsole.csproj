<Project Sdk="Microsoft.NET.Sdk">
	<!--
		Packed-consumer gate (scripts/test-packed-consumers.ps1), consumer (a): a Native AOT console that references
		Purview.Results and Purview.Results.ZodSharp, with Purview.ZodSharp and Purview.ValueObjects, as packages and
		nothing else from the repository. It declares a [GenerateResult] union, so the packed generator runs here.

		Every warning fails the publish, including each IL2xxx (trim) and IL3xxx (AOT) warning ILC reports for the
		generated code and the packed assemblies; the published binary then exits non-zero on any mismatch.
	-->
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net11.0</TargetFramework>
		<LangVersion>preview</LangVersion>
		<AssemblyName>PackedResultsAot</AssemblyName>
		<RootNamespace>PackedResultsAot</RootNamespace>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<PublishAot>true</PublishAot>
		<InvariantGlobalization>true</InvariantGlobalization>
		<TrimmerSingleWarn>false</TrimmerSingleWarn>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<ILLinkTreatWarningsAsErrors>true</ILLinkTreatWarningsAsErrors>
		<IlcTreatWarningsAsErrors>true</IlcTreatWarningsAsErrors>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Purview.Results" Version="$(ResultsPackageVersion)" />
		<PackageReference Include="Purview.Results.ZodSharp" Version="$(ResultsPackageVersion)" />
		<PackageReference Include="Purview.ZodSharp" Version="$(ZodSharpPackageVersion)" />
		<PackageReference Include="Purview.ValueObjects" Version="$(ValueObjectsPackageVersion)" />
	</ItemGroup>

	<Target Name="RequirePackageVersions" BeforeTargets="CollectPackageReferences;Restore">
		<Error
			Condition="'$(ResultsPackageVersion)' == '' or '$(ZodSharpPackageVersion)' == '' or '$(ValueObjectsPackageVersion)' == ''"
			Text="ResultsPackageVersion, ZodSharpPackageVersion and ValueObjectsPackageVersion must be set. Run this consumer through scripts/test-packed-consumers.ps1."
		/>
	</Target>
</Project>
