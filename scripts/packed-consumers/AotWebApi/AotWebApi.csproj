<Project Sdk="Microsoft.NET.Sdk.Web">
	<!--
		Packed-consumer gate (scripts/test-packed-consumers.ps1), consumer (e): a Native AOT minimal API over every
		Purview.Results package - Purview.Results, .ZodSharp, .AspNetCore and .ZodSharp.AspNetCore - and nothing else
		from the repository. The script copies this folder (and the C# files in ../Shared) outside the repository, beside
		guard Directory.Build.props/.targets and Directory.Packages.props files, and supplies the versions as
		$(ResultsPackageVersion) and $(ZodSharpPackageVersion).

		This is what proves the ASP.NET Core packages' IsAotCompatible claim. Handlers return result.ToHttpResult(),
		an IResult, because the request delegate generator resolves JSON metadata for a handler's declared return type
		and a Result<...> has none; the mapper then writes a success as Ok<TValue>/Json<TValue> through
		IResultValue.AcceptSuccess, so only the value type resolves from the host's own JsonSerializerContext. A client
		self-test endpoint calls the API through Purview.ZodSharp.Http and folds each outcome into a result. Every
		warning fails the publish, including each IL2xxx (trim) and IL3xxx (AOT) warning; the published binary is then
		started and called.
	-->
	<PropertyGroup>
		<TargetFramework>net11.0</TargetFramework>
		<AssemblyName>PackedResultsAotWeb</AssemblyName>
		<RootNamespace>PackedResultsAotWeb</RootNamespace>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<PublishAot>true</PublishAot>
		<InvariantGlobalization>true</InvariantGlobalization>
		<TrimmerSingleWarn>false</TrimmerSingleWarn>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<ILLinkTreatWarningsAsErrors>true</ILLinkTreatWarningsAsErrors>
		<IlcTreatWarningsAsErrors>true</IlcTreatWarningsAsErrors>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Purview.Results" Version="$(ResultsPackageVersion)" />
		<PackageReference Include="Purview.Results.ZodSharp" Version="$(ResultsPackageVersion)" />
		<PackageReference Include="Purview.Results.AspNetCore" Version="$(ResultsPackageVersion)" />
		<PackageReference Include="Purview.Results.ZodSharp.AspNetCore" Version="$(ResultsPackageVersion)" />
		<PackageReference Include="Purview.ZodSharp" Version="$(ZodSharpPackageVersion)" />
		<PackageReference Include="Purview.ZodSharp.AspNetCore" Version="$(ZodSharpPackageVersion)" />
		<PackageReference Include="Purview.ZodSharp.Http" Version="$(ZodSharpPackageVersion)" />
	</ItemGroup>

	<Target Name="RequirePackageVersions" BeforeTargets="CollectPackageReferences;Restore">
		<Error
			Condition="'$(ResultsPackageVersion)' == '' or '$(ZodSharpPackageVersion)' == ''"
			Text="ResultsPackageVersion and ZodSharpPackageVersion must be set. Run this consumer through scripts/test-packed-consumers.ps1."
		/>
	</Target>
</Project>
