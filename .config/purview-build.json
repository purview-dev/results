{
	"Build": {
		"Solution": "src/Results.slnx",
		"TestRoot": "src/tests",
		"TestPatterns": "*Tests.csproj",
		"TestProjects": "*Tests*",
		"TestFilter": "/*/*/*/*"
	},
	"PackValidation": {
		// Explicit because Purview.Build 0.5.3 defaults RequiredCompilerFlags to empty. Earlier
		// versions forced this check on and could not be configured off, so these packages have
		// always been validated against it; declaring it keeps that behaviour.
		"RequiredCompilerFlags": [
			"optimization=release"
		],
		// Every package is a library package that produces a symbol package, so RequireSymbolFiles and the
		// assembly checks below all apply to them. Purview.Results additionally carries the merged source
		// generator and its code fix under analyzers/dotnet/cs (no PDB, no lib folder for those), so the
		// source generator is no longer published as its own package.
		"RequireSymbolPackage": false,
		// RequireExplicitContent defaults to true, so this is the exhaustive declaration of what each
		// package ships: a package with no rule here, or an entry matching none of its globs, fails.
		"RequiredContent": {
			"purview.results": [
				"README.md",
				"analyzers/dotnet/cs/Purview.Results.SourceGenerator.CodeFixes.dll",
				"analyzers/dotnet/cs/Purview.Results.SourceGenerator.dll",
				"buildTransitive/Purview.Results.props",
				"lib/$(TFM)/Purview.Results.dll",
				"lib/$(TFM)/Purview.Results.xml",
				"purview-logo-light.png"
			],
			"purview.results.aspnetcore": [
				"README.md",
				"lib/$(TFM)/Purview.Results.AspNetCore.dll",
				"lib/$(TFM)/Purview.Results.AspNetCore.xml",
				"purview-logo-light.png"
			],
			"purview.results.zodsharp": [
				"README.md",
				"lib/$(TFM)/Purview.Results.ZodSharp.dll",
				"lib/$(TFM)/Purview.Results.ZodSharp.xml",
				"purview-logo-light.png"
			],
			"purview.results.zodsharp.aspnetcore": [
				"README.md",
				"lib/$(TFM)/Purview.Results.ZodSharp.AspNetCore.dll",
				"lib/$(TFM)/Purview.Results.ZodSharp.AspNetCore.xml",
				"purview-logo-light.png"
			]
		},
		// Every package ("*"). RequireExplicitContent already rejects anything RequiredContent does not declare; these
		// rules hold even if a RequiredContent glob is ever widened. Mirrors purview-dev/zodsharp's rules. Globs are
		// Microsoft.Extensions.FileSystemGlobbing patterns: "*" stays within one path segment, "**" spans any number,
		// including none. scripts/test-pack-validation-rules.ps1 (`just verify-pack-rules`) proves every rule fails a
		// package.
		"ForbiddenContent": {
			"*": [
				// The generator ships a merged, self-contained analyzer, so the framework assembly must never
				// appear loose beside it.
				"analyzers/**/Purview.SourceGeneratorFramework*",
				// The compiler supplies Roslyn to analyzers; a packed copy would shadow or conflict with it.
				"analyzers/**/Microsoft.CodeAnalysis*",
				// Compiler-host assemblies never appear outside analyzers/: anywhere else NuGet hands them to the
				// application, which is how Purview.SourceGeneratorFramework.dll reached app and Blazor WebAssembly
				// output and broke WebAssembly AOT compilation.
				"Purview.SourceGeneratorFramework*",
				"Microsoft.CodeAnalysis*",
				"lib/**/Purview.SourceGeneratorFramework*",
				"lib/**/Microsoft.CodeAnalysis*",
				"ref/**/Purview.SourceGeneratorFramework*",
				"ref/**/Microsoft.CodeAnalysis*",
				"runtimes/**/Purview.SourceGeneratorFramework*",
				"runtimes/**/Microsoft.CodeAnalysis*",
				"build/**/Purview.SourceGeneratorFramework*",
				"build/**/Microsoft.CodeAnalysis*",
				"buildTransitive/**/Purview.SourceGeneratorFramework*",
				"buildTransitive/**/Microsoft.CodeAnalysis*",
				"buildMultiTargeting/**/Purview.SourceGeneratorFramework*",
				"buildMultiTargeting/**/Microsoft.CodeAnalysis*",
				"tools/**/Purview.SourceGeneratorFramework*",
				"tools/**/Microsoft.CodeAnalysis*",
				"content/**/Purview.SourceGeneratorFramework*",
				"content/**/Microsoft.CodeAnalysis*",
				"contentFiles/**/Purview.SourceGeneratorFramework*",
				"contentFiles/**/Microsoft.CodeAnalysis*",
				// The generator and its code fix run only inside the compiler, so they ship under analyzers/ alone: under
				// lib/, ref/ or runtimes/ every application would load them.
				"lib/**/Purview.Results.SourceGenerator*",
				"ref/**/Purview.Results.SourceGenerator*",
				"runtimes/**/Purview.Results.SourceGenerator*"
			]
		}
	},
	"Release": {
		"Mode": "None"
	}
}